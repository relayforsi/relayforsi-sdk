{
  "name": "relayfor.si",
  "version": "0.2.0",
  "description": "TypeScript SDK for the relayfor.si API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "default": "./dist/solana.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relayforsi/relayforsi-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docs.relayfor.si",
  "bugs": "https://github.com/relayforsi/relayforsi-sdk/issues",
  "keywords": [
    "relayfor.si",
    "solana",
    "launchpad",
    "pump.fun",
    "ai",
    "sdk"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test && tsc --noEmit -p scripts",
    "test": "vitest run --typecheck",
    "build": "tsdown",
    "check:package": "publint --strict && attw --pack . --profile esm-only && size-limit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@types/node": "^22.20.5",
    "msw": "^3.0.2",
    "publint": "^0.3.25",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@scure/base": "^2.4.0"
  }
}
