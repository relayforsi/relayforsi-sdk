{
  "name": "@relayforsi/ai-sdk",
  "version": "0.1.0",
  "description": "relayfor.si provider for the Vercel AI SDK.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relayforsi/relayforsi-sdk.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://docs.relayfor.si",
  "bugs": "https://github.com/relayforsi/relayforsi-sdk/issues",
  "keywords": [
    "relayfor.si",
    "ai",
    "ai-sdk",
    "vercel",
    "llm",
    "provider"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "test": "vitest run",
    "build": "tsdown",
    "check:package": "publint --strict && attw --pack . --profile esm-only && size-limit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@ai-sdk/provider": "^4.0.21",
    "@ai-sdk/provider-utils": "^5.0.53"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^14.1.0",
    "ai": "^7.0.127",
    "msw": "^3.0.2",
    "publint": "^0.3.25",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
